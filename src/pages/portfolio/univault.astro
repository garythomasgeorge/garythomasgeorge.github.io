---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { projects } from "../../data/projects.ts";
import MockupFigure from "../../components/mockups/MockupFigure.astro";
import ScreenshotStrip from "../../components/mockups/ScreenshotStrip.astro";

const project = projects.find((p) => p.slug === "univault")!;
---

<BaseLayout
  title={project.name}
  description="UniVault — an iOS link manager for saving, organizing, and revisiting URLs."
>
  <CaseStudy
    name={project.name}
    type={project.type}
    tags={project.tags}
    links={project.links}
    overview="UniVault is a personal iOS app for capturing URLs the way notes apps capture text — fast in, easy to find later. Built as a side project to scratch a personal organizing itch."
    problem="Read-it-later apps optimize for articles. Bookmark managers feel like browser tabs in disguise. Neither handled the messy reality of saving a tweet, a doc, a YouTube link, and a half-read PDF in the same place."
    role="Solo builder — design, iOS development, and App Store release."
    approach={[
      "Designed around a single capture-and-tag flow as the primary interaction.",
      "Shipped a v1 focused on speed of save and ease of retrieval rather than feature breadth.",
      "Released through the App Store after closed beta with friends.",
    ]}
    outcomes={[]}
  >
    <Fragment slot="showcase">
      <MockupFigure
        title="Capture first, organize later"
        caption="Save from any app through the share sheet, add notes in the app, then sort everything into collections and tags."
        note="App Store screenshots"
      >
        <ScreenshotStrip
          shots={[
            { src: "/screens/univault/1.jpg", alt: "UniVault home screen showing saved links in Your Vault", label: "Your vault" },
            { src: "/screens/univault/2.jpg", alt: "Adding a note or link inside the app", label: "Add notes & links" },
            { src: "/screens/univault/3.jpg", alt: "Share sheet saving a link from another app to UniVault", label: "Share to save" },
            { src: "/screens/univault/4.jpg", alt: "Organizing links into collections and tags", label: "Collections & tags" },
            { src: "/screens/univault/5.jpg", alt: "UniVault sign-in screen with magic link option", label: "Quick sign up" },
          ]}
        />
      </MockupFigure>
    </Fragment>
  </CaseStudy>
</BaseLayout>
