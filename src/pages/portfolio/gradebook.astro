---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CaseStudy from "../../components/CaseStudy.astro";
import { projects } from "../../data/projects.ts";
import GradebookProcess from "../../components/mockups/GradebookProcess.astro";

const project = projects.find((p) => p.slug === "gradebook")!;
---

<BaseLayout
  title={project.name}
  description="Designed and launched the Fedena Gradebook module across 10+ countries — 20% retention lift, 15% sales growth."
>
  <CaseStudy
    name={project.name}
    type={project.type}
    tags={project.tags}
    links={project.links}
    overview="Gradebook is Fedena's configurable assessment and report card module. Instead of forcing one grading model on everyone, it lets each school set up its own exam structure, grading formulas and report card layout. It's used in 10+ countries."
    problem="Even schools that followed a national curriculum graded their own way. Each wanted to adjust the default system with custom formulas and groups of tests across the academic year, but existing systems were built around a single grading model with little or no configuration. Schools were also moving to a mix of test-based and activity- or behaviour-based evaluation to assess the whole student. And every school designed its own report card and refused a default format. With small technology budgets, paying for report card customization was expensive."
    role="User researcher and end-to-end product manager. I ran discovery with schools, sketched and wireframed the experience with our designers, and owned the launch across 10+ country variants."
    approach={[
      "Ran discovery with schools in several countries to map how their grading actually differed from the national system they followed.",
      "Designed a configurable exam structure where schools combine terms, test groups and custom formulas, instead of the product enforcing one model.",
      "Supported scholastic grading and co-scholastic (activity and behaviour) grading side by side, each with its own scale.",
      "Made report cards configurable so schools could keep their own layout without paying for custom development.",
      "Launched in waves by region and tracked retention and sales-growth signals against the rollout schedule.",
    ]}
    outcomes={[
      "20% retention increase among institutions in markets where Gradebook launched.",
      "15% sales growth attributed to the module's availability.",
      "Live in 10+ countries.",
    ]}
  >
    <Fragment slot="showcase">
      <GradebookProcess />
    </Fragment>
  </CaseStudy>
</BaseLayout>
