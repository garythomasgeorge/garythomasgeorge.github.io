---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillBadge from "../components/SkillBadge.astro";
import TimelineItem from "../components/TimelineItem.astro";
import CompactProject from "../components/CompactProject.astro";
import { featuredProjects, projects } from "../data/projects.ts";
import { experience, skillsBuild, skillsHow } from "../data/experience.ts";
import { socials } from "../data/socials.ts";

const linkedin = socials.find((so) => so.label === "LinkedIn")!;
const otherSocials = socials.filter((so) => so.label !== "LinkedIn");

const miniTimeline = experience.slice(0, 2);

// Non-featured work, projects with visuals first
const moreWorkOrder = ["fedena-mobile", "gradebook", "univault", "fedena-id-cards", "cx-agent-studio", "wordle", "fitbit-watchface"];
const moreWork = moreWorkOrder
  .map((slug) => projects.find((p) => p.slug === slug))
  .filter((p) => p !== undefined);

const stats = [
  { value: "300K+", label: "chatbot sessions a day on the assistant I help run" },
  { value: "78%", label: "containment: conversations resolved without a human agent" },
  { value: "10K+", label: "chats a day on a field-tech bot I took from 0 to launch in 4 months" },
  { value: "1,000+", label: "internal users of the transcript analysis tool I built" },
];

const writing = [
  {
    title: "ADK Human-in-the-Loop Middleware",
    blurb: "Part 1: a middleware pattern for adding human approvals to Google ADK agentic flows.",
    href: "https://medium.com/@garythomasgeorge/why-google-adks-human-in-the-loop-story-has-a-production-gap-and-one-way-it-could-be-fixed-66aabef33a32",
  },
  {
    title: "CX Agent Studio — A First Look",
    blurb: "Part 2: an independent product breakdown of Google's enterprise agent platform.",
    href: "https://medium.com/@garythomasgeorge/cx-agent-studio-the-evolution-of-googles-conversational-ai-stack-a-first-look-09d87a95a093",
  },
];
---

<BaseLayout
  title="Gary Thomas George"
  description="Product Manager building conversational AI and agentic systems at enterprise scale: an omnichannel chatbot with 300K+ sessions a day, on Google ADK."
>
  <!-- Hero: intro + numbers, sized to fit the first screen -->
  <section class="hero-mesh border-b border-[var(--color-border)]">
    <div class="container-page py-10 md:py-14 grid gap-10 lg:grid-cols-[1.15fr_1fr] lg:items-center">
      <div>
        <p class="label-mono mb-4">Product Manager · Conversational AI · New York</p>
        <h1 class="font-serif text-4xl md:text-5xl leading-[1.08]">
          I design, ship, and measure conversational AI.
        </h1>
        <p class="mt-4 text-base md:text-lg text-[var(--color-text-muted)] leading-relaxed">
          I'm a product manager on an enterprise chatbot that handles 300K+ sessions a day, and I build the LLM tools that show how it performs. I've spent 10+ years shipping products, from SaaS used by 40,000+ institutions to agentic AI. I prototype ideas myself before asking engineering to build them.
        </p>
        <p class="mt-4 text-sm text-[var(--color-text-muted)]">
          <span class="label-mono text-[var(--color-accent)] mr-2">Currently</span>
          Product Manager @ <span class="text-[var(--color-text-primary)]">Fortune 50 Telecom</span> · via <span class="text-[var(--color-text-primary)]">Capgemini</span> · Google ADK, Conversational Agents &amp; CX Agent Studio
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a href={linkedin.href} target="_blank" rel="noopener noreferrer" class="btn-primary">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={linkedin.icon} />
            Connect on LinkedIn
          </a>
          <a href="/gary-thomas-george-resume.pdf" download class="btn-ghost">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="12" y1="4" x2="12" y2="16"/>
              <polyline points="6 11 12 17 18 11"/>
              <line x1="5" y1="20" x2="19" y2="20"/>
            </svg>
            Resume (PDF)
          </a>
          <div class="flex items-center gap-2">
            {otherSocials.map((so) => (
              <a
                href={so.href}
                target={so.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={so.href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                aria-label={so.label}
                title={so.label}
                class="w-10 h-10 grid place-items-center rounded-lg border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={so.icon} />
              </a>
            ))}
          </div>
        </div>
      </div>

      <dl class="grid grid-cols-2 gap-3">
        {stats.map((s) => (
          <div class="card p-4 md:p-5">
            <dt class="sr-only">{s.label}</dt>
            <dd class="font-serif text-3xl md:text-4xl leading-none text-[var(--color-accent)]">{s.value}</dd>
            <dd class="mt-2 text-xs md:text-sm text-[var(--color-text-muted)] leading-snug">{s.label}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Featured projects -->
  <section class="container-page py-12 md:py-16">
    <header class="flex items-end justify-between gap-4 mb-6">
      <div>
        <p class="label-mono">Selected Work</p>
        <h2 class="font-serif text-2xl md:text-3xl mt-1">Featured projects</h2>
      </div>
      <a href="/portfolio" class="link-accent text-sm hidden sm:inline-flex items-center gap-1.5">
        All work
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="5" y1="12" x2="19" y2="12"/>
          <polyline points="12 5 19 12 12 19"/>
        </svg>
      </a>
    </header>

    <div class="grid gap-5 md:grid-cols-3">
      {featuredProjects.map((p) => <ProjectCard project={p} />)}
    </div>

    <!-- More work: three with visuals up front, the rest tucked behind a toggle -->
    <div class="mt-10">
      <p class="label-mono mb-3">More work</p>
      <div class="grid gap-3 md:grid-cols-3">
        {moreWork.slice(0, 3).map((p) => <CompactProject project={p} />)}
      </div>
      <details class="more-work mt-3 group">
        <summary class="list-none cursor-pointer inline-flex items-center gap-1.5 text-sm link-accent">
          <span class="group-open:hidden">Show {moreWork.length - 3} more</span>
          <span class="hidden group-open:inline">Show less</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="transition-transform group-open:rotate-180" aria-hidden="true">
            <polyline points="6 9 12 15 18 9"/>
          </svg>
        </summary>
        <div class="grid gap-3 md:grid-cols-3 mt-3">
          {moreWork.slice(3).map((p) => <CompactProject project={p} />)}
        </div>
      </details>
    </div>
  </section>

  <hr class="hr-fade" />

  <!-- Skills -->
  <section class="container-page py-12 md:py-16">
    <p class="label-mono">Stack &amp; Approach</p>
    <h2 class="font-serif text-2xl md:text-3xl mt-1">How I work</h2>
    <p class="mt-3 mb-8 text-[var(--color-text-muted)] max-w-2xl">
      I'm a builder-first PM — comfortable in Figma, readable in code, and at home in the terminal. I've shipped across conversational AI, mobile apps, SaaS platforms, and data tools, and I bring the same structured thinking to every layer of the stack.
    </p>

    <div class="grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-medium tracking-wide uppercase text-[var(--color-text-muted)] mb-5">Tools &amp; technologies</h3>
        <div class="flex flex-wrap gap-2">
          {skillsBuild.map((s) => <SkillBadge label={s} />)}
        </div>
      </div>
      <div>
        <h3 class="text-sm font-medium tracking-wide uppercase text-[var(--color-text-muted)] mb-5">My approach</h3>
        <ul class="space-y-3 text-[var(--color-text-primary)]">
          {skillsHow.map((s) => (
            <li class="flex gap-3 text-sm leading-relaxed">
              <span class="text-[var(--color-accent)] mt-0.5 shrink-0">▹</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <hr class="hr-fade" />

  <!-- Mini timeline -->
  <section class="container-page py-12 md:py-16">
    <p class="label-mono">Path</p>
    <h2 class="font-serif text-2xl md:text-3xl mt-1 mb-6">Recent experience</h2>

    <div class="space-y-6 max-w-2xl">
      {miniTimeline.map((e) => (
        <TimelineItem
          company={e.company}
          role={e.role}
          client={e.client}
          product={e.product}
          location={e.location}
          dateRange={`${e.start}–${e.end}`}
          compact={true}
        />
      ))}
    </div>

    <a href="/resume" class="link-accent inline-flex items-center gap-1.5 mt-6 text-sm">
      View full resume
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </a>
  </section>

  <hr class="hr-fade" />

  <!-- Writing -->
  <section class="container-page py-12 md:py-16">
    <p class="label-mono">Writing</p>
    <h2 class="font-serif text-2xl md:text-3xl mt-1 mb-6">From the blog</h2>

    <div class="grid gap-5 md:grid-cols-2">
      {writing.map((w) => (
        <a
          href={w.href}
          target="_blank"
          rel="noopener noreferrer"
          class="card p-6 block group"
        >
          <p class="label-mono mb-3 text-[var(--color-text-muted)] group-hover:text-[var(--color-accent)] transition-colors">Medium</p>
          <h3 class="font-serif text-xl leading-snug mb-3">{w.title}</h3>
          <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">{w.blurb}</p>
          <span class="link-accent inline-flex items-center gap-1.5 mt-4 text-sm">
            Read post
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="5" y1="12" x2="19" y2="12"/>
              <polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
