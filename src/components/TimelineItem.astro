---
import SkillBadge from "./SkillBadge.astro";
import type { ExperienceGroup } from "../data/experience.ts";

interface Props {
  company: string;
  role: string;
  client?: string;
  officialTitle?: string;
  product?: string;
  location: string;
  dateRange: string;
  bullets?: string[];
  groups?: ExperienceGroup[];
  stack?: string[];
  compact?: boolean;
}

const {
  company,
  role,
  client,
  officialTitle,
  product,
  location,
  dateRange,
  bullets = [],
  groups = [],
  stack = [],
  compact = false,
} = Astro.props;
---

<article class="relative pl-6 border-l border-[var(--color-border)]">
  <span class="absolute left-0 top-2 w-2 h-2 -translate-x-1/2 rounded-full bg-[var(--color-accent)]"></span>

  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h3 class="font-serif text-xl">{company}</h3>
    <span class="text-sm text-[var(--color-text-muted)]">— {role}</span>
  </div>

  <p class="label-mono mt-1">
    {dateRange} · {location}
  </p>

  {(client || product) && (
    <p class="mt-2 text-sm text-[var(--color-text-muted)]">
      {client && <><span class="text-[var(--color-text-primary)]">Client:</span> {client}</>}
      {!compact && officialTitle && <> · <span class="text-[var(--color-text-primary)]">{company} title:</span> {officialTitle}</>}
      {product && <><span class="text-[var(--color-text-primary)]">Product:</span> {product}</>}
    </p>
  )}

  {!compact && bullets.length > 0 && (
    <ul class="mt-4 space-y-2 text-sm text-[var(--color-text-primary)] leading-relaxed">
      {bullets.map((b) => (
        <li class="flex gap-3">
          <span class="text-[var(--color-accent)] mt-1.5 shrink-0">▹</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  )}

  {!compact && groups.map((g) => (
    <section class="mt-4">
      <h4 class="text-sm">
        <span class="font-semibold text-[var(--color-text-primary)]">{g.title}</span>
        <span class="text-[var(--color-text-muted)]"> ({g.detail})</span>
      </h4>
      <ul class="mt-2 space-y-2 text-sm text-[var(--color-text-primary)] leading-relaxed">
        {g.bullets.map((b) => (
          <li class="flex gap-3">
            <span class="text-[var(--color-accent)] mt-1.5 shrink-0">▹</span>
            <span><strong class="font-semibold">{b.label}:</strong> {b.text}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {!compact && stack.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5">
      {stack.map((s) => <SkillBadge label={s} />)}
    </div>
  )}
</article>
