---
// Row of real app screenshots. Scrolls sideways on phones, spreads into a
// grid on wider screens.
interface Shot {
  src: string;
  alt: string;
  label?: string;
}
interface Props {
  shots: Shot[];
}
const { shots } = Astro.props;
---

<div class="strip flex gap-4 overflow-x-auto snap-x snap-mandatory pb-2 md:grid md:overflow-visible md:pb-0" style={`--cols:${shots.length}`}>
  {shots.map((s) => (
    <div class="snap-center shrink-0 w-[46%] sm:w-[30%] md:w-auto flex flex-col gap-2">
      <img
        src={s.src}
        alt={s.alt}
        loading="lazy"
        decoding="async"
        class="w-full h-auto rounded-xl border border-[var(--color-border)] shadow-lg"
      />
      {s.label && <p class="label-mono text-[0.6rem] text-center">{s.label}</p>}
    </div>
  ))}
</div>

<style>
  @media (min-width: 768px) {
    .strip { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); }
  }
</style>
