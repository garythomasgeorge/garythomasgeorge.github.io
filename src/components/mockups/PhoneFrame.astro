---
// Minimal phone shell for chat mockups. Content goes in the default slot.
interface Props {
  title: string;
  subtitle: string;
  label?: string;
}
const { title, subtitle, label } = Astro.props;
---

<div class="flex flex-col items-center gap-3 w-full max-w-[320px] mx-auto">
  {label && <p class="label-mono text-[0.65rem]">{label}</p>}
  <div class="phone w-full rounded-[2rem] p-2 shadow-xl">
    <div class="rounded-[1.6rem] overflow-hidden bg-[var(--color-surface)] border border-[var(--color-border)] flex flex-col h-[620px]">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-[var(--color-border)]">
        <div class="w-8 h-8 rounded-full grid place-items-center bg-[var(--color-accent)] text-[var(--color-bg)] text-xs font-semibold">AI</div>
        <div class="min-w-0">
          <p class="text-sm font-medium leading-tight">{title}</p>
          <p class="text-[0.7rem] text-[var(--color-text-muted)] leading-tight flex items-center gap-1">
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-accent)]"></span>
            {subtitle}
          </p>
        </div>
      </div>
      <div class="flex-1 overflow-hidden px-3 py-4 space-y-3 text-[0.8rem] leading-snug">
        <slot />
      </div>
      <div class="px-3 py-3 border-t border-[var(--color-border)]">
        <div class="rounded-full border border-[var(--color-border)] px-4 py-2 text-[0.75rem] text-[var(--color-text-muted)]">Type a message…</div>
      </div>
    </div>
  </div>
</div>

<style>
  .phone {
    background: color-mix(in oklab, var(--color-text-primary) 85%, var(--color-bg));
  }
</style>
